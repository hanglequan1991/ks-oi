/**
 * Wrangler config for the `hotel-dictionary` Worker (Version 1 site: billing
 * page and JSON API). It is a separate Worker with its own D1 database.
 * Owner steps are in DEPLOY-hotel-dictionary.md.
 *
 * Replace REPLACE_WITH_D1_ID with the database_id printed by
 * `npx wrangler d1 create hotel-dictionary` before deploying.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hotel-dictionary",
	"main": "src/site.ts",
	"compatibility_date": "2026-11-10",
	"observability": {
		"enabled": true
	},
	/**
	 * Build step: bundles the browser code into public/bill.js before deploy.
	 */
	"build": {
		"command": "npm run build:client"
	},
	/**
	 * D1 database (settings, hotels, cities). The Phase 2 sheet sync will write here.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hotel-dictionary",
			"database_id": "c0adf755-e105-40e9-ab03-5cee6216d971",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Static assets. Matching files are served before the Worker runs (no
	 * run_worker_first, so static requests are not billed as Worker requests).
	 */
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	/**
	 * Sheet sync schedule (hourly). One string; the owner may change it.
	 * The Worker runs the sync from the `scheduled` handler. The per-run budget,
	 * the circuit breaker and the stale-run abandon protect against a stuck run
	 * repeating. To pause the sync, comment this out or set it to [] and redeploy
	 * (see "Pause the sync" in DEPLOY-hotel-dictionary.md).
	 */
	"triggers": {
		"crons": ["0 * * * *"]
	},
	/**
	 * Plain variables (not secrets).
	 * DRIVE_FOLDER_ID: the public Drive folder id. REPLACE_WITH_DRIVE_FOLDER_ID is a
	 * placeholder; the Worker treats it as unconfigured and skips the sync (logged).
	 * SKIP_TABS: JSON array of strings to skip, matched case-insensitively. Each entry
	 * is either "File name/Tab name" (skips that tab in that one file, no .xlsx) or a
	 * tab name alone (skips every tab with that name in every file), for example
	 * ["File/Tab", "Tab name"].
	 * MAX_TABS_PER_RUN and SUBREQUEST_BUDGET: per-run limits, as strings. The values
	 * shown are the Free-plan defaults (Free allows 50 subrequests per invocation).
	 * On a Paid plan (1000 subrequests) the owner may raise them, for example
	 * "1000" and "200". See "Limits" in DEPLOY-hotel-dictionary.md.
	 *
	 * Secret (not in this file): SYNC_TOKEN, set with `wrangler secret put SYNC_TOKEN`.
	 * Without it, POST /internal/sync answers 404.
	 *
	 * Optional AI binding (not used by the site), left off:
	 * "ai": { "binding": "AI" }
	 */
	"vars": {
		"DRIVE_FOLDER_ID": "1DnRvtjrOSN35DWYlZMyPxhVsswvX98vM",
		"SKIP_TABS": "[]",
		"MAX_TABS_PER_RUN": "25",
		"SUBREQUEST_BUDGET": "40"
	}
}
